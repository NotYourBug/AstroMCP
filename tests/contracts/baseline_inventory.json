          "type": "string"
        },
        "path": {
          "default": "/",
          "description": "要检查的磁盘路径（如 / 或 C:）",
          "type": "string"
        },
        "threshold": {
          "default": 85,
          "description": "磁盘使用率告警阈值，默认 85%",
          "type": "integer"
        },
        "username": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "SSH 用户名（仅远程需要）"
        },
