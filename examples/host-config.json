{
  "transport": "stdio",
  "bind_host": "127.0.0.1",
  "bind_port": 8081,
  "tool_timeout_seconds": 30,
  "queue_timeout_seconds": 2,
  "ssh_connect_timeout_seconds": 8,
  "ssh_command_timeout_seconds": 15,
  "ssh_max_in_flight": 4,
  "ssh_max_per_target": 2,
  "ssh_output_limit_bytes": 262144,
  "ssh_known_hosts": "TEST_ONLY_KNOWN_HOSTS_PATH",
  "disk_threshold": 85
}
